OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openrouter/free

# Optional for cluster-hosted OpenAI-compatible local LLMs:
NOETHER_OPENAI_BASE_URL=http://cluster-node:8000/v1
NOETHER_OPENAI_MODEL=local-lean-coder
# NOETHER_OPENAI_API_KEY=replace-if-required

# Maestro cluster presets are also available without env:
# ./noether demo physics-toy --llm maestro
# ./noether demo physics-toy --llm piano
# ./noether demo physics-toy --llm sitar
# ./noether demo physics-toy --llm violin
